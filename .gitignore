# build output
node_modules/
dist/
dist-*/
src-tauri/target/
src-tauri/gen/android/app/build/
src-tauri/gen/android/build/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/app/src/main/jniLibs/
src-tauri/gen/android/tauri.settings.gradle
src-tauri/gen/android/local.properties
src-tauri/gen/android/tauri.properties

# packaged apps / local sideload server
.serve/
*.apk
*.idsig
*.aab
# Release artifacts staged here on the way to a GitHub release. They belong on
# the release page, not in git history — a 24 MB installer per version would
# be in every clone forever.
*.exe
SHA256SUMS.txt

# signing material and env (none should ever be committed)
*.keystore
*.jks
key.properties
keystore.properties
.env
.env.*

# large binaries fetched or built by scripts (see THIRD-PARTY-NOTICES.md)
public/models/*.onnx
public/tessdata/*.gz
src-tauri/android-binaries/
src-tauri/binaries/

# local test data (generated by scripts/fixtures.ps1 and src/dev/mktable.py)
fixtures/
devfixtures/
src/dev/tbl/

# editor backups, caches, logs
*.bak
*.bak-*
__pycache__/
*.pyc
*.log
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logo drafts. brand/make-options.py regenerates the whole sheet; the repo
# carries the icon that was chosen, not the eight that were not.
brand/options/

# Instagram/social artwork and captions, generated by assets/_gen/gen.py.
# Marketing drafts are not part of the software and change on a different
# clock than releases do; keeping them out means a `git add -A` can never
# push a caption that was still being argued about. Delete this line if you
# decide the campaign should ship with the source.
assets/

# Written by scripts/build-apk.ps1 before every Android build. It holds this
# machine's absolute paths -- which is exactly what it exists to remap out of
# the shipped .so -- so it is the last file that should ever be committed.
src-tauri/.cargo/

# Belt and braces: none of these exist in the tree today, and none ever should.
# Browser-automation scratch, private keys (including Tauri updater keys),
# password notes, and stray screenshots at the repo root.
.playwright-mcp/
*.pem
*.p12
*.pfx
*.key
*password*.txt
*pass*.txt
/screenshot*.png
dev/papers/
