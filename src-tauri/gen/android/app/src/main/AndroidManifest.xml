<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- FACET is a file explorer, so it needs to see files it did not create.
         The scoped-storage ladder means three separate grants:
           - API <= 29: the classic READ/WRITE pair, plus requestLegacyExternalStorage
             below so API 29 keeps the flat /storage/emulated/0 view the Rust
             side lists.
           - API 30+: MANAGE_EXTERNAL_STORAGE ("All files access"). This is the
             permission Play restricts to file managers — which is exactly what
             this is — and it is what makes browsing an arbitrary folder work
             instead of only the media store.
           - API 33+: the granular READ_MEDIA_* trio, needed even with the above
             for the photo/video/audio modules.
           - API 34+: READ_MEDIA_VISUAL_USER_SELECTED, which is what Android 14
             grants when the user picks "Select photos" instead of "Allow all".
             MediaBridge.access() tests for it to word the empty state honestly,
             and an undeclared permission always reports denied — so leaving it
             out made a partial grant read as no grant at all.
         All of these are runtime grants; nothing is taken silently at install. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- The camera and voice-recorder panels use getUserMedia. Tauri's
         WebChromeClient already answers the WebView's PermissionRequest by
         launching a runtime prompt for CAMERA / RECORD_AUDIO — but a runtime
         prompt for a permission the manifest never declared is denied
         instantly and silently, which is what "the camera panel opens black
         and nothing happens" looks like. MODIFY_AUDIO_SETTINGS is in the same
         list the WebView asks for, so it is declared alongside.
         Both are still runtime grants; nothing is taken at install. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Declared not-required so a device without a camera can still install
         and use the other forty-odd tools. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- `extractNativeLibs` stays true and is NOT redundant: the bundled ffmpeg
         and ffprobe ship as jniLibs/arm64-v8a/libffmpeg.so and are *executed*
         from ApplicationInfo.nativeLibraryDir. A compressed-in-APK library has
         no filesystem path to exec, so turning this off would silently kill
         every video tool on the phone. -->
    <application
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.facet"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- "Open with FACET".

                 A file explorer that cannot be picked to open a file is a
                 strange thing, and until now FACET was exactly that: it was
                 absent from every Open-with list on the phone, including for
                 the formats it renders better than anything else installed.

                 Two filters rather than one because Android matches them
                 whole. The first names the types FACET actually renders, so it
                 ranks as a specific match and appears near the top of the
                 chooser for a picture or a PDF. The second is the file
                 manager's claim: `*/*`, for the `.dng`, `.jxl`, `.srt`, `.obj`
                 and the extensionless blob that no other app on the device
                 offers to open at all. A wildcard match ranks last, so it
                 costs the common case nothing.

                 `singleTask` above is what makes the running app take a second
                 file rather than stacking a second copy of itself; the intent
                 arrives at `MainActivity.onNewIntent`. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="font/*" />
                <data android:mimeType="model/*" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="*/*" />
                <data android:scheme="content" android:mimeType="*/*" />
            </intent-filter>

            <!-- The share sheet's other direction: "Send to FACET". One file
                 or a whole selection, from the gallery, a chat, a browser
                 download. A shared URI often has no path on this disk at all
                 (a mail attachment, a Drive file), which is why `OpenBridge`
                 ends its ladder by copying the bytes into the app's cache
                 rather than by failing. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- The WebView runs in this process, so anything it fetches is
             attributed to this app's UID. Two of its defaults reach Google
             without the app asking:
               - Safe Browsing pulls its URL list and pings on navigation.
               - The WebView metrics/UMA client uploads usage stats.
             Neither is wanted here, and leaving them on made logcat show a
             real DNS lookup by com.iraslabs.facet — which flatly contradicts
             the one claim this app makes about itself. Both off. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
